{
  "name": "central-leads-panel-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed-demo-leads.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production && pm2 save",
    "pm2:reload": "pm2 startOrReload ecosystem.config.js --env production --update-env && pm2 save",
    "pm2:restart": "pm2 restart central-leads-api --update-env",
    "pm2:stop": "pm2 stop central-leads-api",
    "pm2:delete": "pm2 delete central-leads-api && pm2 save",
    "pm2:status": "pm2 describe central-leads-api",
    "pm2:logs": "pm2 logs central-leads-api --lines 200",
    "pm2:monit": "pm2 monit",
    "pm2:startup": "pm2 startup",
    "deploy": "bash ../deploy/deploy.sh"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "smtp-server": "^3.21.6"
  }
}
