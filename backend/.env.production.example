# Production settings for https://clp.cpaleasing.com
# On the VPS:  cp backend/.env.production.example backend/.env  &&  nano backend/.env
# Fill every value marked CHANGE_ME. Never commit backend/.env.

NODE_ENV=production
PORT=4000
# Only Nginx on the same server talks to the API.
HOST=127.0.0.1
# Behind Nginx (one proxy hop): rate limits see the real visitor IP.
TRUST_PROXY=1

# ---- Database (use a dedicated MySQL user with rights on this DB only, not root) ----
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=CLP

# ---- Secrets: generate each one on the server, never reuse the development values ----
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=12h
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a safe copy: if it changes, saved SMTP passwords must be entered again.
SECRET_ENCRYPTION_KEY=CHANGE_ME

# ---- Domain ----
CORS_PANEL_ORIGIN=https://clp.cpaleasing.com
APP_BASE_URL=https://clp.cpaleasing.com

# ---- First super admin (only used by `npm run seed`, once) ----
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=CHANGE_ME
SEED_ADMIN_PASSWORD=CHANGE_ME

TZ=Asia/Kolkata
