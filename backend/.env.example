NODE_ENV=development
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=central_leads
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
# Comma separated list of dashboard origins
CORS_PANEL_ORIGIN=http://localhost:5180
# Set to 1 when running behind Nginx (one proxy hop) so client IPs are correct
TRUST_PROXY=0
# Interface the API listens on. Keep 127.0.0.1 so only Nginx on the same server can reach it.
HOST=127.0.0.1
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
TZ=Asia/Kolkata
# 32-byte key that encrypts stored SMTP passwords (AES-256-GCM). Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe: if it changes, saved SMTP passwords must be entered again.
SECRET_ENCRYPTION_KEY=
# Public URL of the dashboard, used for "View lead" links in emails
APP_BASE_URL=http://localhost:5180
